                throw std::invalid_argument(string_format("error: failed to open file '%s'\n", value.c_str()));
            }
            params.sampling.cfg_negative_prompt.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
            if (!params.sampling.cfg_negative_prompt.empty() && params.sampling.cfg_negative_prompt.back() == '\n') {
                params.sampling.cfg_negative_prompt.pop_back();
            }
        }
    ).set_examples({LLAMA_EXAMPLE_COMPLETION}));

