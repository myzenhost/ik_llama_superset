    add_opt(common_arg(
        {"--allowlist-unicode-rule"}, "RULE",
        "llama-server allowlist sampler: add a rule LOWER..UPPER,SCRIPT:BIAS (or ascii[:BIAS]) to the current rule set; "
        "a token is allowed only if every codepoint matches a rule (repeatable)",
        [](common_params & params, const std::string & value) {
            // LOWER..UPPER,SCRIPT:BIAS  -- "ascii" = 0..0x7F any script; no script = any; empty bound = open
            auto parse = [](const std::string & argstr) {
                auto subs = string_split(argstr, std::string(":"));
                const float bias = subs.size() == 1 ? 0.0f : std::stof(subs[1]);
                subs = string_split(subs[0], std::string(","));
                const std::string & tail = subs.back();
                std::string script = (!tail.empty() && std::all_of(tail.begin(), tail.end(), [](char c) { return std::isalpha((unsigned char) c) != 0; }))
                    ? string_lower(tail) : "*";
                if (script == "ascii") {
                    return std::make_tuple((uint32_t) 0x000000, (uint32_t) 0x00007F, std::string("*"), bias);
                }
                uint32_t first = 0;
                uint32_t last  = (uint32_t) -1;
                if (script == "*" || subs.size() > 1) {
                    subs = string_split(subs.front(), std::string("."));
                    if (!subs.front().empty()) { first = (uint32_t) std::stoul(subs.front()); }
                    if (!subs.back().empty())  { last  = (uint32_t) std::stoul(subs.back()); }
                }
                return std::make_tuple(std::min(first, last), std::max(first, last), script, bias);
            };
            if (params.allow_rules.empty()) {
                params.allow_rules.push_back({});
            }
            params.allow_rules.back().push_back(parse(value));
        }
    ).set_examples({LLAMA_EXAMPLE_SERVER}));

